{
  "name": "firebase-direct-studio",
  "version": "2.0.0",
  "description": "Local GitHub to Firebase Hosting deployment dashboard with optional AI repair",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "check": "node --check server.js && node --check public/app.js",
    "release:check": "node scripts/check-release.js"
  },
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "express": "^4.21.2",
    "firebase-tools": "15.34.0"
  },
  "overrides": {
    "firebase-tools": {
      "chokidar": "4.0.3",
      "@google-cloud/pubsub": { "@opentelemetry/core": "2.8.0" }
    },
    "gaxios@6.7.1": { "uuid": "11.1.1" }
  }
}
